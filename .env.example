DATABASE_URL="file:./prisma/dev.db"

# Server-only secret used to sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Used only by `npm run seed:admin` to create/update the initial admin user.
# Not read at runtime; safe to unset after seeding.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
